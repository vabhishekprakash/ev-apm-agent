# ===== Data — never commit raw or intermediate CSMS data =====
data/raw/*
data/interim/*
data/processed/*
*.csv
*.parquet
*.feather
*.h5
# Keep folder skeletons and docs committed even though their contents are ignored:
!data/raw/.gitkeep
!data/raw/EXPORT_NOTES.md
!data/interim/.gitkeep
!data/processed/.gitkeep
# Allow inventory/reference CSVs to be committed explicitly:
!data/reference/*.csv

# ===== Model artifacts =====
*.pkl
*.joblib
*.pt
*.pth
*.onnx
models/*.bin
!models/.gitkeep

# ===== Secrets & environment =====
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ===== Jupyter =====
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
# Optional: strip notebook outputs before commit
# *.ipynb

# ===== Testing / linting / type-checking =====
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ===== Docker =====
*.pid
docker-compose.override.yml

# ===== IDE / editor =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== Logs & temp =====
*.log
logs/
tmp/
*.tmp

# ===== Local overrides =====
local_config.py
config.local.yaml
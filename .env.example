MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# 0 = dump the whole history at once so the dashboard is populated within
# seconds of `docker compose up` (real exports span months, so 1 = real-time
# would leave it blank). Use 60 for a progressive, live-feel build when
# recording the demo video.
REPLAY_SPEED_MULTIPLIER=0
DATA_DIR=./data/raw
# Silence-fault threshold: no MeterValues during an active session for longer
# than this fires a telemetry_silence alert (3x the observed 30s meter cadence).
SILENCE_THRESHOLD_SECONDS=90
# Layer 2 drift flag: session flagged when IsolationForest decision_function
# score < threshold. Code default -0.1 (SPEC); -0.1187 is calibrated on
# held-out normals to a 4.0% false-positive rate (notebook 03, global-pool
# retrain of 2026-07-04).
LAYER2_THRESHOLD=-0.1187
# Where the detector POSTs alerts: stdout (default) or http -> ALERT_URL.
ALERT_SINK=stdout
ALERT_URL=http://ui:8000/alerts

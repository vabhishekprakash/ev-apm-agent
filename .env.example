MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
REPLAY_SPEED_MULTIPLIER=1
DATA_DIR=./data/raw
# Silence-fault threshold: no MeterValues during an active session for longer
# than this fires a telemetry_silence alert (3x the observed 30s meter cadence).
SILENCE_THRESHOLD_SECONDS=90
